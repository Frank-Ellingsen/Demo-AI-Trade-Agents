# Copy to .env and fill only local credentials. NEVER commit .env to GitHub.

# --- Local-First LLM (Default) ---
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Cloud LLM Fallback (Optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Active Broker: Alpaca Paper Trading (Strict Paper-Only Safeguard) ---
EXECUTION_MODE=paper
LIVE_EXECUTION_ACK=
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# --- Primary Approval Channel: Telegram Human-in-the-Loop (HITL) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Secondary Failover Approval Channel: SMTP Email (Optional) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
WEBHOOK_BASE_URL=http://localhost:8000

# --- Optional Market Data & Runner Security ---
MASSIVE_API_KEY=
RUNNER_SECRET=

# --- Optional Nordic Reference Broker (Saxo SIM) ---
SAXO_ENV=sim
SAXO_OPENAPI_BASE_URL=https://gateway.saxobank.com/sim/openapi
SAXO_APP_KEY=
SAXO_APP_SECRET=
SAXO_ACCOUNT_KEY=

# --- Local Databases ---
SQLITE_DB_PATH=data/hitl_orders.db
DUCKDB_PATH=data/obx_analytics.duckdb
